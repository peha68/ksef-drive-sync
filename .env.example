# --- KSeF ---
# Środowisko: test | demo | prod
KSEF_ENV=test
# NIP firmy, dla której pobieramy faktury
KSEF_NIP=0000000000
# Token autoryzacyjny wygenerowany w aplikacji KSeF (Twoje konto -> Tokeny)
# UWAGA: tokeny KSeF wygasają 31.12.2026 - trzeba wtedy przejść na certyfikat
KSEF_AUTH_TOKEN=

# Czy pobierać faktury jako nabywca (koszty) czy sprzedawca (przychody) czy obie strony
# wartości: buyer | seller | both
# Wpływa na prefiks plików: ksef_koszt_<numer> (Subject2/nabywca) vs
# ksef_przychod_<numer> (Subject1/sprzedawca) - patrz index.js / ksefClient.js.
KSEF_SUBJECT_ROLE=both

# --- Google Drive (OAuth 2.0) ---
# Service account może odpaść: Google od pewnego czasu domyślnie blokuje na
# nowych projektach tworzenie kluczy JSON dla kont serwisowych
# (iam.disableServiceAccountKeyCreation), nawet bez formalnej organizacji.
# Jeśli u Ciebie się uda tę politykę wyłączyć - service account jest
# prostszym rozwiązaniem. Tu zakładamy OAuth 2.0 z jednorazowo wygenerowanym
# refresh tokenem (patrz README.md, sekcja "Autoryzacja Google Drive (OAuth)").

# Identyfikator i sekret klienta OAuth (typ aplikacji: Desktop app),
# z Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Refresh token wygenerowany jednorazowo lokalnie przez
# `npm run get-refresh-token` (node scripts/get-refresh-token.js)
GOOGLE_OAUTH_REFRESH_TOKEN=

# ID docelowego folderu na Dysku Google (Twoim koncie, na które robisz OAuth)
# Znajdziesz je w adresie URL folderu w przeglądarce: drive.google.com/drive/folders/<TO_JEST_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Ogólne ---
# Ile dni wstecz sprawdzać przy każdym uruchomieniu (zapas na wypadek przestoju/awarii)
INVOICE_LOOKBACK_DAYS=7
LOG_FILE=./data/sync.log

# Adres, na który wysyłane jest mailowe podsumowanie każdego uruchomienia
# (przez Gmail API - refresh token musi mieć zakres gmail.send, patrz README).
NOTIFY_EMAIL=

# --- Archiwum miesięczne (src/monthlyArchive.js, patrz README) ---
# Adres księgowości - dostaje ZIP z fakturami/skanami za poprzedni miesiąc.
ACCOUNTING_EMAIL=
# Dopóki 'false', ZIP leci TYLKO na NOTIFY_EMAIL (tryb testowy) - ustaw na
# 'true', dopiero gdy potwierdzisz, że archiwum wygląda poprawnie.
MONTHLY_ARCHIVE_SEND_TO_ACCOUNTING=false
